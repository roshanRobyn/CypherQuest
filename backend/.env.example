# Port the backend HTTP server listens on
PORT=3001

# Comma-separated list of allowed CORS origins (Vite dev server default shown)
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Required in production to authorize POST /api/admin/reset.
# In non-production, the reset endpoint works without this token.
ADMIN_RESET_TOKEN=change-me-dev-token

# Authoritative Cypher Quest release moment (fixed +05:30 offset — never
# reinterpreted against server/client timezone). Defaults to the real event
# time below if unset; only override this to change the actual event time.
EVENT_START_AT=2026-09-24T13:30:00+05:30

# DEV/TEST ONLY — force the event gate to "WAITING" or "ACTIVE" locally
# without touching EVENT_START_AT above. Ignored entirely in production.
# Leave empty to use the real EVENT_START_AT comparison.
EVENT_STATE_OVERRIDE=

# Authoritative hunt-duration window feeding the in-gameplay Hunt Timer
# HUD (5-minute warning + visible countdown are always END minus 5 minutes
# — never configured separately). Hunt start coincides with the real event
# release moment above; defaults to the real 90-minute production window
# if unset; only override to change the actual hunt duration.
HUNT_START_AT=2026-09-24T13:30:00+05:30
HUNT_END_AT=2026-09-24T15:00:00+05:30

# DEV/TEST ONLY — same guarantee as EVENT_STATE_OVERRIDE above: only ever
# honored when NODE_ENV !== "production" (enforced in eventService.js's
# resolveHuntEndMs), so production ignores this even if it were ever set
# there. Set to a few minutes from now to test the 5-minute warning/
# countdown/expiry (both the "team completed" -> final-treasure.html path
# and the "team did not complete" -> Hunt Expired screen path) without
# touching HUNT_END_AT (the real value) at all. Leave empty to disable.
HUNT_END_AT_DEV_OVERRIDE=
