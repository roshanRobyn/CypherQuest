# Port the backend HTTP server listens on
PORT=3001

# Comma-separated list of allowed CORS origins (Vite dev server default shown)
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Required in production to authorize POST /api/admin/reset.
# In non-production, the reset endpoint works without this token.
ADMIN_RESET_TOKEN=change-me-dev-token

# Authoritative Cypher Quest release moment (fixed +05:30 offset — never
# reinterpreted against server/client timezone). Defaults to the real event
# time below if unset; only override this to change the actual event time.
EVENT_START_AT=2026-09-24T13:30:00+05:30

# DEV/TEST ONLY — force the event gate to "WAITING" or "ACTIVE" locally
# without touching EVENT_START_AT above. Ignored entirely in production.
# Leave empty to use the real EVENT_START_AT comparison.
EVENT_STATE_OVERRIDE=
